digraph Roles {
  graph [rankdir=LR, fontname="Arial", label="Роли ResearchRadar MAS"];
  node [shape=box, style="rounded,filled", fillcolor="#e8f0fa", fontname="Arial"];
  user [label="Пользователь", fillcolor="#f5f5f5"];
  coord [label="Координатор\nплан и назначение"];
  sci [label="Научный агент\nOpenAlex"];
  news [label="Новостной агент\nGDELT"];
  syn [label="Синтезатор\nограниченная сводка"];
  user -> coord;
  coord -> sci;
  coord -> news;
  sci -> syn [style=dashed, label="через координатора"];
  news -> syn [style=dashed];
  syn -> user [label="результат"];
}
